{
  "manifest_version": 3,
  "name": "Roblox 2016 Classic",
  "version": "1.20.115",
  "permissions": [
    "storage",
    "activeTab",
    "userScripts"
  ],
  "host_permissions": [
    "http://127.0.0.1:38261/*",
    "https://larp.3xjn.dev/*",
    "https://www.roblox.com/*",
    "https://github.com/3xjn/larpblox-extension/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "larpbux-game-background.js"
  },
  "description": "Manage Larp mode, pretend balance, and Roblox appearance from the extension popup.",
  "action": {
    "default_title": "Larpblox",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "larpbux-body-colors.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "remote-bootstrap.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/larpblox-logo.png",
        "assets/source-sans-pro-*.woff2",
        "assets/robux-classic*.svg",
        "assets/builders-club.png",
        "assets/builders-club-outline.svg",
        "assets/limited-classic.png",
        "assets/limited-unique-classic.png"
      ],
      "matches": [
        "https://www.roblox.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "138",
  "sandbox": {
    "pages": [
      "popup-sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:;"
  }
}
